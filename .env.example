# Copy to .env and fill in. Never commit .env.
# Settings use the PROPINTEL_ prefix; __ separates nested fields.

# --- Database -----------------------------------------------------------
# docker compose maps Postgres to host port 5433.
PROPINTEL_DATABASE_URL=postgresql+asyncpg://propintel:propintel@localhost:5433/propintel

# --- Claude -------------------------------------------------------------
PROPINTEL_LLM__API_KEY=sk-ant-...
# Sonnet tier: RAG answers, digest narrative, complex summarization.
PROPINTEL_LLM__SMART_MODEL=claude-sonnet-5
# Haiku tier: bulk structured extraction, entity-resolution adjudication.
PROPINTEL_LLM__FAST_MODEL=claude-haiku-4-5
PROPINTEL_LLM__ENABLED=true

# --- Embeddings ---------------------------------------------------------
# fastembed downloads the ONNX model (~30 MB) to ~/.cache/fastembed on first run.
# No API key required. Keep the default unless you change the VECTOR(n) column width.
PROPINTEL_EMBEDDING__MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -hex 32
PROPINTEL_SECURITY__SECRET_KEY=change-me-openssl-rand-hex-32

# --- Scraping -----------------------------------------------------------
# Passed through to webscraper-core. Keep robots on.
SCRAPER_FETCH__RESPECT_ROBOTS=true
SCRAPER_THROTTLE__RATE=0.5
SCRAPER_LLM__ENABLED=true
ANTHROPIC_API_KEY=sk-ant-...

# --- Notifications (Phase 3) --------------------------------------------
PROPINTEL_NOTIFY__RESEND_API_KEY=
PROPINTEL_NOTIFY__SLACK_WEBHOOK_URL=
PROPINTEL_NOTIFY__FROM_EMAIL=alerts@example.com

# --- CORS ---------------------------------------------------------------
# Space-separated list of allowed origins. Add your Vercel URL in production.
# PROPINTEL_CORS_ORIGINS=["https://your-app.vercel.app","https://your-custom-domain.com"]

# --- Ops ----------------------------------------------------------------
PROPINTEL_SENTRY_DSN=
PROPINTEL_ENVIRONMENT=development
PROPINTEL_LOG_LEVEL=INFO
